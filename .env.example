GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
# Local database from docker-compose.yml; leave empty to use the in-memory index.
DATABASE_URL=postgresql://tax:tax@localhost:5432/morocco_tax
# Only for the pgvector test (tests/test_store.py): a separate database, so the
# test never overwrites the real index (see docker-compose.yml).
TEST_DATABASE_URL=postgresql://tax:tax@localhost:5432/morocco_tax_test
